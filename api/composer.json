{
  "name": "traders/api-rest-php",
  "description": "API REST em PHP para integração com Binance e Coinbase - Sem dependências de runtime",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "TradersApi\\": "src/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "stan": "vendor/bin/phpstan analyse",
    "serve": "php -S localhost:8080 -t . index.php"
  }
}
