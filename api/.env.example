APP_ENV=development
APP_DEBUG=true

# Autenticacao Basic (protege todas as rotas).
# Em producao (APP_ENV=production) e OBRIGATORIO definir usuario e senha:
# sem eles a API recusa as requisicoes com HTTP 503, a menos que
# ALLOW_UNAUTHENTICATED=true seja definido explicitamente (ex: atras de um gateway).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
ALLOW_UNAUTHENTICATED=false

# Binance
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TESTNET=false
BINANCE_RECV_WINDOW=5000
BINANCE_SSL_VERIFY=false
BINANCE_CA_BUNDLE=

# Coinbase
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_KEY_FILE=
COINBASE_BASE_URL=https://api.coinbase.com
COINBASE_SSL_VERIFY=false
COINBASE_CA_BUNDLE=
