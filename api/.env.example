# Ambiente
APP_ENV=development
# Mantenha APP_DEBUG=false por padrão. Ligue (true) apenas em desenvolvimento;
# em debug as mensagens de erro internas são expostas na resposta.
APP_DEBUG=false

# Autenticacao Basic (protege todas as rotas, exceto /api/health).
# Em producao (APP_ENV=production) e OBRIGATORIO definir usuario e senha:
# sem eles a API recusa as requisicoes com HTTP 503, a menos que
# ALLOW_UNAUTHENTICATED=true seja definido explicitamente (ex: atras de um gateway).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
ALLOW_UNAUTHENTICATED=false

# Binance
# Recomenda-se configurar as chaves AQUI (server-side) em vez de enviá-las por
# requisição. Se precisar enviar por request, use os cabeçalhos
# X-API-Key / X-API-Secret — NUNCA a query string (ela vaza em logs/histórico).
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TESTNET=false
# Mantenha a verificacao de SSL habilitada. Desligue (false) apenas em
# desenvolvimento local se o seu ambiente nao tiver um CA bundle valido.
BINANCE_SSL_VERIFY=true
BINANCE_CA_BUNDLE=

# Coinbase
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_KEY_FILE=
COINBASE_BASE_URL=https://api.coinbase.com
COINBASE_SSL_VERIFY=true
COINBASE_CA_BUNDLE=

# Rate limiting (opcional) — protege rotas de conta/trading por IP
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# Observabilidade (opcional)
METRICS_ENABLED=false
# APP_LOG_FILE=storage/logs/app.log
CORS_ALLOWED_ORIGINS=http://localhost:3000
